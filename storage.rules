rules_version = '2';

// Reglas de Cloud Storage. Las usa el banner de publicidad que sube
// CrearContenidoPantalla. Despliega con:
//
//     firebase deploy --only storage
//
service firebase.storage {
  match /b/{bucket}/o {

    // Los banners los ve cualquiera; subirlos exige sesion iniciada.
    match /publicidades/{archivo} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
